# retrain.py's rollback backups — local safety copies only, never shipped
models/model_backup_*.pkl

# DVC cache must never be committed — it's local/remote storage, not source.
# (DVC-tracked data/model files themselves are excluded via the .gitignore
# files DVC auto-generates inside data/raw/, data/processed/, and models/ —
# only the small *.dvc pointer files are tracked in git for those.)
.dvc/cache/
.dvc/tmp/
